# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production / any hosted environment: use Postgres (Neon, Supabase, Render…).
# The app switches engines automatically when DATABASE_URL is set.
#
# DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/biopulse?sslmode=require
#
# Without DATABASE_URL the app falls back to a SQLite file at data/biopulse.db.
# That file is EPHEMERAL on Render/Railway/Fly — it is erased on every deploy.
# If you must stay on SQLite, mount a disk and point DB_PATH at it:
#
# DB_PATH=/var/data/biopulse.db

# Demo roster (15 sample employees + a month of attendance) is opt-in.
# SEED_DEMO=1

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Base URL of the API. Leave empty when the same service serves the UI
# (npm run build + npm start) or when Vite's dev proxy is used.
# For a separate frontend host (Vercel), set this to the backend origin at
# BUILD time, e.g. VITE_API_BASE_URL=https://biopulse-api.onrender.com
VITE_API_BASE_URL=
